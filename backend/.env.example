APP_NAME=LeadScrapy Clone
ENV=development
DEBUG=true

SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql://postgres:postgres@db:5432/leadscrapy

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

DEFAULT_MAX_PAGES=50
DEFAULT_CRAWL_DEPTH=2
DEFAULT_REQUEST_DELAY_MS=800
RESPECT_ROBOTS_TXT=true

FREE_PLAN_MONTHLY_CREDITS=100

# Google Places API — create a key in Google Cloud Console with Places API enabled
GOOGLE_PLACES_API_KEY=

FRONTEND_URL=http://localhost:3000

# Stripe — create these Prices in the Stripe dashboard first
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# SMTP — works with SES SMTP, Postmark, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Lead Console <noreply@example.com>
